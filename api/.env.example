# Copy to .env and adjust. Every setting is optional except VS_API_KEY in production.

# Shared secret expected in the X-API-Key header (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
VS_API_KEY=

# Models (Hugging Face ids)
VS_EMBEDDING_MODEL=patrickjohncyh/fashion-clip
VS_DETECTOR_MODEL=google/owlv2-base-patch16-finetuned
VS_PRELOAD_DETECTOR=true
VS_DEVICE=cpu

# Where vectors.db lives
VS_DATA_DIR=./data

# Search tuning
VS_MIN_SCORE_FASHION=0.20
VS_MIN_SCORE_GENERAL=0.22
VS_DETECT_THRESHOLD=0.22
VS_OVERSAMPLE=6
VS_MAX_TOP_K=100

# Input limits
VS_MAX_UPLOAD_MB=10
# Comma separated hosts allowed for /v1/index image URLs (recommended: your store's media host)
VS_ALLOWED_IMAGE_HOSTS=

# Only used by scripts/index_catalog.py woocommerce (create a READ-ONLY REST key)
WC_STORE_URL=https://shop.example.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
